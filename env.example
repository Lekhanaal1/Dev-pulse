# DevPulse Environment Configuration
# Copy this file to .env and update the values for your environment

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devpulse_users

# MongoDB Configuration
MONGO_URI=mongodb://mongo:27017/devpulse_tasks

# NATS Configuration
NATS_URL=nats://nats:4222

# Service URLs (for API Gateway)
USER_SERVICE_URL=http://user-service:8000
TASK_SERVICE_URL=http://task-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production Settings (uncomment and configure for production)
# JWT_SECRET=your-production-jwt-secret-here
# POSTGRES_PASSWORD=your-secure-postgres-password
# MONGO_URI=mongodb://your-mongo-instance:27017/devpulse_tasks
# NEXT_PUBLIC_API_URL=https://your-api-domain.com 